<div class="blueholme-card">
  <header class="card-title">{{label}}</header>
  <div class="big-roll {{#if ok}}good{{else}}bad{{/if}}">{{total}}</div>
  <p class="mods">d% against {{chance}}%{{#if auto}} (96-00 always fails){{/if}}</p>
  <p class="verdict">{{#if ok}}Success{{else}}Failure{{/if}}</p>
</div>
