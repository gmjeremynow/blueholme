<div class="blueholme-card">
  <header class="card-title">Learning {{name}}</header>
  <div class="big-roll {{#if ok}}good{{else}}bad{{/if}}">{{total}}</div>
  <p class="mods">d% against {{chance}}% · minimum {{min}}, maximum {{max}} per level</p>
  <p class="verdict">{{#if ok}}Learned and inscribed in the magic book.{{else}}Not understood: marked as not learned.{{/if}}</p>
</div>
