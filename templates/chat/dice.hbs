<div class="blueholme-card">
  <header class="card-title">{{title}}</header>
  {{#if label}}<p class="small">{{label}}</p>{{/if}}
  <div class="big-roll">{{total}}</div>
  <p class="mods">{{formula}}</p>
  {{#if dmg}}<div class="card-buttons"><button type="button" data-card-action="apply"><i class="fa-solid fa-heart-crack"></i> Apply</button><button type="button" data-card-action="apply-half">½ (saved)</button></div>{{/if}}
  {{#if heal}}<div class="card-buttons"><button type="button" data-card-action="heal"><i class="fa-solid fa-heart"></i> Apply healing</button></div>{{/if}}
</div>
