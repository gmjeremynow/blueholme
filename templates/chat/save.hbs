<div class="blueholme-card">
  <header class="card-title">Save vs. {{label}}</header>
  <div class="big-roll {{#if ok}}good{{else}}bad{{/if}}">{{total}}</div>
  <p class="mods">d20{{#if bonus}} {{bonus}}{{/if}} against {{target}}</p>
  <p class="verdict">{{#if ok}}Saved{{else}}Failed{{/if}}</p>
</div>
