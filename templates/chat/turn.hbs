<div class="blueholme-card">
  <header class="card-title">Turn Undead</header>
  <p class="small">Cleric level {{level}} against {{col}} HD undead: table entry {{entry}}</p>
  {{#if needed}}<div class="big-roll {{#if ok}}good{{else}}bad{{/if}}">{{rolled}}</div><p class="mods">2d6, needs {{needed}}</p>{{/if}}
  <p class="verdict">{{result}}</p>
</div>
